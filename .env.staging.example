# Variable contract for the staging Vercel project (Production scope) and for a local .env.staging.
# Previews hold none of the three Supabase values. Never commit real values.
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>
# The instance_id inserted into lifecycle.instance_identity when staging was provisioned.
INSTANCE_ID=<staging-instance-id>
ADMINISTRATOR_EMAIL=heimannshua@gmail.com
PAID_ADAPTERS_ENABLED=false
SYNTHETIC_DATA_ENABLED=true
# Story 1.3. Optional, and left unset on purpose: set it deliberately before running the seed command.
# The audited seed command pre-authorizes ADMINISTRATOR_EMAIL as the Administrator and every address
# listed here (comma-separated) as a member. For staging that is the second address Josh uses today.
# SEED_ACCOUNT_EMAILS=daniel@orvex.ai
# Story 1.3. Required. Production-scope Vercel variables only (never Preview, which must hold neither).
# Generate each on your own machine with `openssl rand -base64 32`; see docs/secrets.md.
INVITATION_HASH_KEY=<staging-invitation-hash-key>
RATE_LIMIT_HASH_KEY=<staging-rate-limit-hash-key>
# Story 1.6. Required, Production-scope Vercel variables only (a preview must hold neither key). RECOVERY_HASH_KEY is a
# third random key, different from the two above: `openssl rand -base64 32`. RESEND_API_KEY sends the Administrator
# recovery link from the resend.dev sender (docs/secrets.md). APP_ORIGIN is the https origin the recovery link points at.
RECOVERY_HASH_KEY=<staging-recovery-hash-key>
RESEND_API_KEY=<staging-resend-api-key>
APP_ORIGIN=<staging-app-origin>
# Story 1.12. The file gateway. Optional (the ticket route answers 503 and the staging cleanup records `no_store` without them) and Production-scope Vercel
# variables only (a preview must hold none of the keys). FILE_GATEWAY_URL is the https origin of the Railway gateway service. SERVICE_SIGNING_KEY_APPLICATION
# is the private half of the application's Ed25519 key and SERVICE_KEYS_APPLICATION the public key set (JSON) the gateway holds; see docs/secrets.md. The
# gateway's own variables (GATEWAY_DATABASE_URL, GATEWAY_STORAGE_S3_*, APP_ORIGIN, INSTANCE_ID, APP_ENV, SERVICE_KEYS_APPLICATION) live in the Railway service;
# GATEWAY_DATABASE_URL there must end in ?sslmode=require (or verify-ca or verify-full): the gateway refuses to start for staging without it.
# FILE_GATEWAY_URL=<staging-gateway-origin>
# SERVICE_SIGNING_KEY_APPLICATION=<staging-service-signing-key>
# SERVICE_KEYS_APPLICATION=<staging-service-key-set>
# Story 1.13. Operational alarms. SERVICE_KEYS_HEARTBEAT is the heartbeat issuer's public key set (JSON, not secret) that the application verifies the Railway
# cron task's heartbeat with; optional, and the monitor watches for a missing heartbeat (condition heartbeat-stale) only once it is set. The task's own variables
# (APP_ENV, INSTANCE_ID, APP_ORIGIN, SERVICE_KEYS_HEARTBEAT and its private key, SERVICE_SIGNING_KEY_HEARTBEAT) live in its Railway service, never here: the private
# half is not an application variable and a preview must not hold it. See docs/secrets.md and docs/staging.md.
# SERVICE_KEYS_HEARTBEAT=<staging-heartbeat-key-set>
