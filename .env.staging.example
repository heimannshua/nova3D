# Variable contract for the staging Vercel project (Production scope) and for a local .env.staging.
# Previews hold none of the three Supabase values. Never commit real values.
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>
# The instance_id inserted into lifecycle.instance_identity when staging was provisioned.
INSTANCE_ID=<staging-instance-id>
ADMINISTRATOR_EMAIL=heimannshua@gmail.com
PAID_ADAPTERS_ENABLED=false
SYNTHETIC_DATA_ENABLED=true
# Story 1.3. Optional, and left unset on purpose: set it deliberately before running the seed command.
# The audited seed command pre-authorizes ADMINISTRATOR_EMAIL as the Administrator and every address
# listed here (comma-separated) as a member. For staging that is the second address Josh uses today.
# SEED_ACCOUNT_EMAILS=daniel@orvex.ai
# Story 1.3. Required. Production-scope Vercel variables only (never Preview, which must hold neither).
# Generate each on your own machine with `openssl rand -base64 32`; see docs/secrets.md.
INVITATION_HASH_KEY=<staging-invitation-hash-key>
RATE_LIMIT_HASH_KEY=<staging-rate-limit-hash-key>
