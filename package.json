{
  "name": "nova3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "check:env": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "check:provisioning": "node scripts/check-provisioning.mjs",
    "render:provisioning": "node scripts/render-provisioning.mjs",
    "prebuild": "node scripts/check-env.mjs --deployment",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:env": "node scripts/test-env.mjs",
    "test:health": "node scripts/test-health.mjs",
    "test:dev-origins": "node --experimental-strip-types scripts/test-dev-origins.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@upstash/redis": "1.38.4",
    "@upstash/workflow": "1.3.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "bmad-method": "^6.11.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.3.5",
    "pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "yaml": "2.9.0"
  }
}
