# Copy to .env.local for local development, or run `supabase start` and then
# `node scripts/setup-env.mjs local`, which fills in the stack values, INSTANCE_ID and NOVA3D_QUEUE_PREFIX.
# Never commit real values.
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
# Must be a loopback URL while APP_ENV=local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# The lifecycle.instance_identity.instance_id of the local stack (written by setup-env).
INSTANCE_ID=replace-with-local-instance-id
# Non-secret queue namespace, derived from the matching identity row (written by setup-env).
NOVA3D_QUEUE_PREFIX=nova3d:local:<local-instance-uuid>
ADMINISTRATOR_EMAIL=heimannshua@gmail.com
# Story 1.3. Optional, and left unset on purpose: set it deliberately. `npm run seed:accounts -- preauthorize`
# pre-authorizes ADMINISTRATOR_EMAIL as the Administrator and every address listed here (comma-separated)
# as a member. Uncomment to seed members locally.
# SEED_ACCOUNT_EMAILS=daniel@orvex.ai
# Story 1.3. Required. Random keys (at least 32 bytes, base64, different from each other) under which
# invitation codes and client addresses are hashed. `node scripts/setup-env.mjs local` generates both;
# never reuse them in another environment.
INVITATION_HASH_KEY=replace-with-local-invitation-hash-key
RATE_LIMIT_HASH_KEY=replace-with-local-rate-limit-hash-key
# Story 1.6. Required. A third random key (same shape, different from the other two) under which the Administrator
# recovery token is hashed. `node scripts/setup-env.mjs local` generates it.
RECOVERY_HASH_KEY=replace-with-local-recovery-hash-key
# Required callback origin: local loopback HTTP; setup-env supplies this default if absent or invalid. Recovery links
# continue to use the request origin locally.
# Staging and production use their HTTPS app origin. This is not a secret.
APP_ORIGIN=http://127.0.0.1:3000
# Story 1.6. Recovery mail goes to the Supabase stack's Mailpit locally; hosted environments set RESEND_API_KEY.
# RESEND_API_KEY=
NOVA3D_DEV_ORIGINS=localhost,127.0.0.1,10.103.0.9
PAID_ADAPTERS_ENABLED=false
SYNTHETIC_DATA_ENABLED=true
# Story 1.12. The file gateway (workers/files) moves a user's private files, and the application signs the tickets and commands it accepts. None of
# these is required (the ticket route answers 503 and the staging cleanup records `no_store` without them), and none may be set in a preview.
# `node scripts/setup-env.mjs local` writes an Ed25519 pair for the application (SERVICE_SIGNING_KEY_APPLICATION is its private half, SERVICE_KEYS_APPLICATION
# the public key set the gateway holds) and, from the running stack, the gateway's own database role and Storage key pair (the last five names). The local
# database is on loopback and takes the connection as it is; the same variable in staging or production must carry ?sslmode=require (or verify-ca or
# verify-full), and the gateway refuses to start without it. Run the gateway beside the application with:
#   APP_ORIGIN=http://127.0.0.1:3000 node --env-file=.env.local workers/files/src/main.ts
FILE_GATEWAY_URL=http://127.0.0.1:8080
# SERVICE_SIGNING_KEY_APPLICATION=
# SERVICE_KEYS_APPLICATION=
# GATEWAY_DATABASE_URL=
# GATEWAY_STORAGE_S3_ENDPOINT=
# GATEWAY_STORAGE_S3_REGION=
# GATEWAY_STORAGE_S3_ACCESS_KEY_ID=
# GATEWAY_STORAGE_S3_SECRET_ACCESS_KEY=
# Story 1.13. Operational alarms. The application watches the Railway heartbeat only when SERVICE_KEYS_HEARTBEAT is set: it is the heartbeat issuer's public key set
# (not secret; optional, and left to `node scripts/setup-env.mjs local`, which writes an Ed25519 pair for it, kid local-1, with the private half beside it as
# SERVICE_SIGNING_KEY_HEARTBEAT). The private half is the heartbeat task's alone (workers/heartbeat): in staging and production it lives in the Railway task and
# never in the application, and it may not be set in a preview. Run the task against the running application with:
#   APP_ORIGIN=http://127.0.0.1:3000 node --env-file=.env.local workers/heartbeat/src/main.ts
# SERVICE_KEYS_HEARTBEAT=
# SERVICE_SIGNING_KEY_HEARTBEAT=
