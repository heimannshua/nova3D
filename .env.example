# Copy to .env.local for local development. Never commit real values.
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
PAID_ADAPTERS_ENABLED=false
SYNTHETIC_DATA_ENABLED=true
AUTH_ALLOWED_EMAILS=heimannshua@gmail.com,daniel@orvex.ai
NOVA_INTERIM_PASSWORD=<temporary-private-preview-password>
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
