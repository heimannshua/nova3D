# Variable contract for the production Vercel project. No production project exists yet, so
# production deploys stay disabled. Never commit real values.
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://<production-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<production-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<production-service-role-key>
# The instance_id inserted into lifecycle.instance_identity when production was provisioned.
INSTANCE_ID=<production-instance-id>
ADMINISTRATOR_EMAIL=<administrator-email>
PAID_ADAPTERS_ENABLED=true
SYNTHETIC_DATA_ENABLED=false
# Story 1.3. Optional, and left unset on purpose: production seeding is decided in Story 8.7, and a
# production secret is never read from a file on a laptop. When it is decided, the audited seed command
# pre-authorizes ADMINISTRATOR_EMAIL as the Administrator and every address listed here (comma-separated)
# as a member.
# SEED_ACCOUNT_EMAILS=
# Story 1.3. Required. Generate each with `openssl rand -base64 32`; see docs/secrets.md.
INVITATION_HASH_KEY=<production-invitation-hash-key>
RATE_LIMIT_HASH_KEY=<production-rate-limit-hash-key>
# Story 1.6. Required. RECOVERY_HASH_KEY is a third random key, different from the two above (`openssl rand -base64 32`).
# RESEND_API_KEY sends the Administrator recovery link from the resend.dev sender; APP_ORIGIN is the https origin the
# link points at. See docs/secrets.md.
RECOVERY_HASH_KEY=<production-recovery-hash-key>
RESEND_API_KEY=<production-resend-api-key>
APP_ORIGIN=<production-app-origin>
# Story 1.12. The file gateway. Optional (the ticket route answers 503 and the staging cleanup records `no_store` without them). FILE_GATEWAY_URL is the https
# origin of the production Railway gateway service; SERVICE_SIGNING_KEY_APPLICATION is the private half of the application's Ed25519 key and SERVICE_KEYS_APPLICATION
# the public key set (JSON) the gateway holds; see docs/secrets.md. The gateway's own variables live in its Railway service.
# FILE_GATEWAY_URL=<production-gateway-origin>
# SERVICE_SIGNING_KEY_APPLICATION=<production-service-signing-key>
# SERVICE_KEYS_APPLICATION=<production-service-key-set>
# Story 1.13. Operational alarms. SERVICE_KEYS_HEARTBEAT is the heartbeat issuer's public key set (JSON, not secret) that the application verifies the production Railway
# cron task's heartbeat with; optional. The task's own variables, the private key SERVICE_SIGNING_KEY_HEARTBEAT included, live in its Railway service, never here.
# SERVICE_KEYS_HEARTBEAT=<production-heartbeat-key-set>
